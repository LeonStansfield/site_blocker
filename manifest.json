{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "1.5",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "site-blocker@emeastansfie",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["puzzle.html"],
      "matches": ["<all_urls>"]
    }
  ]
}